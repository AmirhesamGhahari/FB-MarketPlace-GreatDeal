# AWS region to deploy all resources into.
region = "ca-central-1"
app_name = "fb-marketplace-greatdeals"

db_master_username = "your_db_username"
db_master_password = "REPLACE_ME_secure_password_min_8_chars"
db_name            = "fb_marketplace_greatdeals"



github_owner  = "your-github-username"
github_repo   = "FB-MarketPlace-GreatDeal"
github_branch = "main"

category_configs = ["iphone", "macbook"]

# Deal alert emails go here (confirm the SNS subscription email after apply).
alert_email = "your-real-email@example.com"
