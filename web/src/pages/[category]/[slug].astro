---
import Breadcrumb from "../../components/Breadcrumb.astro";
import Disclosure from "../../components/Disclosure.astro";
import LastUpdated from "../../components/LastUpdated.astro";
import ProductTabs from "../../components/ProductTabs.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import StatCard from "../../components/StatCard.astro";
import Base from "../../layouts/Base.astro";
import OverviewChart from "../../components/charts/OverviewChart";
import { getProduct, getSeries } from "../../lib/api";
import { getCatalog, hasData } from "../../lib/catalog";
import { money, moneyShort } from "../../lib/format";
import { productSummary } from "../../lib/text";

// Runs once at build time: lists every page this file must produce, as /{category}/{slug}/.
export async function getStaticPaths() {
  const { categories } = await getCatalog();
  return categories.flatMap((category) =>
    category.products
      .filter(hasData)
      .map((product) => ({ params: { category: category.category_key, slug: product.slug } })),
  );
}

const { category: categoryKey, slug } = Astro.params;
const categoryName = (await getCatalog()).categories.find((c) => c.category_key === categoryKey)!.category_name;
const { data: product, data_as_of } = await getProduct(slug!);
const { series } = (await getSeries(slug!)).data;

// Kept short: Google shows about 60 characters of a title (the site name is appended by the layout).
const title = `${product.display_name} Price in Canada (${moneyShort(product.avg_price_30d)} avg)`;
const description =
  `${product.display_name} asking prices on Facebook Marketplace in Canada: ` +
  `30-day average ${money(product.avg_price_30d)}, cheapest 25% under ${money(product.cutoff_price_cheapest_25pct_30d)}, ` +
  `from ${product.listings_30d ?? 0} listings.`;
---

<Base title={title} description={description}>
  <Breadcrumb
    items={[
      { label: "Home", href: "/" },
      { label: categoryName, href: `/${categoryKey}/` },
      { label: product.display_name },
    ]}
  />
  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{product.display_name}</h1>
  <p class="mt-2 text-slate-500">
    Asking prices on Facebook Marketplace, all configurations · <LastUpdated iso={data_as_of} />
  </p>
  <div class="mt-6">
    <ProductTabs categoryKey={categoryKey!} slug={slug!} current="overview" />
  </div>
  <p class="mt-6 max-w-3xl text-slate-600">{productSummary(product)}</p>

  <section class="mt-8 grid gap-4 sm:grid-cols-3" aria-label="Price statistics">
    <StatCard label="30-day average" value={money(product.avg_price_30d)} note={`${product.listings_30d ?? 0} listings`} />
    <StatCard label="7-day average" value={money(product.avg_price_7d)} note={`${product.listings_7d ?? 0} listings`} />
    <StatCard
      label="Cheapest 25% under"
      value={money(product.cutoff_price_cheapest_25pct_30d)}
      note="30-day price cutoff"
    />
  </section>

  <section class="mt-10">
    <SectionHeading title="Price trend" id="trend" />
    <div class="mt-4">
      <OverviewChart client:visible series={series} />
    </div>
  </section>

  <section class="mt-10">
    <SectionHeading title="Cheapest listings (30 days)" id="cheapest" />
    <ol class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200">
      {(product.lowest_5_deals_30d ?? []).map((deal) => (
        <li class="flex items-center justify-between px-5 py-3">
          <span class="font-medium">{money(deal.price)}</span>
          {deal.url && <a href={deal.url} rel="nofollow noopener" class="text-sm">View on Facebook</a>}
        </li>
      ))}
    </ol>
  </section>

  <div class="mt-10">
    <Disclosure />
  </div>
</Base>
