---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Carousel from "../../components/Carousel.astro";
import ModelColumn from "../../components/ModelColumn.astro";
import { aroundCenter, byPopularity, getCatalog, getCategoryDeals, getCategoryTotals } from "../../lib/catalog";
import { formatDateTime } from "../../lib/format";
import { categoryValues, pageMeta } from "../../lib/seo";

// One page per category, built from this single file: /iphone/, /macbook/, ...
export async function getStaticPaths() {
  const { categories } = await getCatalog();
  return categories.map((category) => ({ params: { category: category.category_key } }));
}

const { category: categoryKey } = Astro.params;
const category = (await getCatalog()).categories.find((c) => c.category_key === categoryKey)!;
const { data_as_of } = await getCategoryDeals(categoryKey!);
const totals = await getCategoryTotals(category);

// The model with the most listings in the middle of the carousel, the others around it in order.
const arranged = aroundCenter([...category.products].sort(byPopularity));

const name = category.category_name;
const meta = pageMeta("category", categoryValues(name, category.products));
---

<Base title={meta.title} description={meta.description}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: name }]} />

  <h1 data-pagefind-meta="title" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{meta.h1}</h1>
  <div data-pagefind-body class="mt-3 max-w-3xl space-y-3 text-lg text-slate-600">
    <p>
      What are people really asking for a used {name} in Canada? We track {totals.listings30d.toLocaleString("en-CA")} listings
      from the last 30 days across {totals.models} models. Each one below shows its 30-day and 7-day average asking price, the
      price that the cheapest 25% of listings fall under, and the cheapest deals right now, so you know what a fair price looks
      like and when a bargain shows up.
    </p>
    <p>
      Use the "cheapest 25% under" figure as a yardstick: a listing priced below it is cheaper than about three quarters of
      the comparable listings. Pick a model for its price history and today's best deals. All prices are asking prices in
      Canadian dollars from public listings, updated after each data refresh ({formatDateTime(data_as_of)}).
    </p>
  </div>

  <section class="mt-10" aria-labelledby="models-heading">
    <h2 id="models-heading" class="text-xl font-semibold tracking-tight">{name} models</h2>
    <div class="mt-2">
      <Carousel label={`${name} models`}>
        {
          arranged.items.map((card, index) => (
            <li data-carousel-item data-carousel-start={index === arranged.center ? "" : undefined}>
              <ModelColumn variant="category" card={card} categoryKey={category.category_key} />
            </li>
          ))
        }
      </Carousel>
    </div>
  </section>

</Base>
