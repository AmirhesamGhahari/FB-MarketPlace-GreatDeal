---
// A product's all-listings page: /{category}/{slug}/listings/. Not for Google (noindex, follow; also left out of the
// sitemap): a long table of Facebook listing titles that changes daily. The table loads in the browser.
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import LastUpdated from "../../../../components/LastUpdated.astro";
import ListingsTable from "../../../../components/listings/ListingsTable";
import ProductTabs from "../../../../components/ProductTabs.astro";
import StatPanel from "../../../../components/StatPanel.astro";
import Base from "../../../../layouts/Base.astro";
import { getCatalog, getProductPaths, getProductSummary } from "../../../../lib/catalog";
import { count, moneyShort } from "../../../../lib/format";
import { modelValues, pageMeta } from "../../../../lib/seo";
import { formatPct, percentDiff, quarterOf } from "../../../../lib/text";

export async function getStaticPaths() {
  return getProductPaths();
}

const { category: categoryKey, slug } = Astro.params;
const category = (await getCatalog()).categories.find((c) => c.category_key === categoryKey)!;
const { data: product, data_as_of } = await getProductSummary(slug!);
const name = product.display_name;
const pagePath = `/${categoryKey}/${slug}/`;
const meta = pageMeta("model_listings", modelValues(product));
---

<Base title={meta.title} description={meta.description} noindex>
  <Breadcrumb
    items={[
      { label: "Home", href: "/" },
      { label: category.category_name, href: `/${categoryKey}/` },
      { label: name, href: pagePath },
      { label: "All listings" },
    ]}
  />
  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{meta.h1}</h1>
  <p class="mt-2 text-slate-500">
    Asking prices on Facebook Marketplace, all configurations · <LastUpdated iso={data_as_of} />
  </p>
  <div class="mt-6">
    <ProductTabs categoryKey={categoryKey!} slug={slug!} current="listings" />
  </div>

  <p class="mt-6 max-w-3xl text-slate-600">
    Every recent {name} listing in one table. Sort by price to see the cheapest first, or by how far below the average a
    listing sits, and filter by period to catch the cheap ones that were just posted. Use the "cheapest 25% under" price
    below as your yardstick.
  </p>

  <section class="mt-6 grid gap-4 sm:grid-cols-3" aria-label="Statistics">
    <StatPanel
      label="30-day average"
      value={moneyShort(product.avg_price_30d)}
      note="CAD, asking price, last 30 days"
      icon="calendar"
      tone="blue"
      lines={[{ label: "Listings in 30 days", value: count(product.listings_30d) }]}
    />
    <StatPanel
      label="7-day average"
      value={moneyShort(product.avg_price_7d)}
      note="CAD, asking price, last 7 days"
      icon="trend"
      tone="orange"
      lines={[
        { label: "Listings in 7 days", value: count(product.listings_7d) },
        {
          label: "Compared with 30 days",
          value: percentDiff(product.avg_price_7d, product.avg_price_30d) === null ? "n/a" : formatPct(percentDiff(product.avg_price_7d, product.avg_price_30d)!),
        },
      ]}
    />
    <StatPanel
      label="Cheapest 25% under"
      value={moneyShort(product.cutoff_price_cheapest_25pct_30d)}
      note="CAD: a quarter of the listings are priced below this (30 days)"
      icon="tag"
      tone="green"
      lines={[
        { label: "Listings below it", value: quarterOf(product.listings_30d) === null ? "n/a" : `about ${count(quarterOf(product.listings_30d))}` },
        { label: "Same price, 7 days", value: moneyShort(product.cutoff_price_cheapest_25pct_7d) },
      ]}
    />
  </section>

  <section class="mt-8" aria-label="Listings">
    <ListingsTable client:load slug={slug!} categoryKey={categoryKey!} />
    <noscript>
      <p class="rounded-xl border border-slate-200 p-5 text-slate-600">This table needs JavaScript to load the listings.</p>
    </noscript>
  </section>

  <p class="mt-8 flex flex-wrap gap-x-6 gap-y-1 text-sm">
    <a href={pagePath}>← Back to the {name} overview</a>
    <a href={`${pagePath}top-deals/`}>See the best deals →</a>
  </p>

</Base>
