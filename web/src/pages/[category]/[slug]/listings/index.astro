---
// A product's all-listings page: /{category}/{slug}/listings/. Not for Google (noindex, follow; also left out of the
// sitemap): a long table of Facebook listing titles that changes daily. The table loads in the browser.
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import LastUpdated from "../../../../components/LastUpdated.astro";
import ListingsTable from "../../../../components/listings/ListingsTable";
import ProductTabs from "../../../../components/ProductTabs.astro";
import StatCard from "../../../../components/StatCard.astro";
import Base from "../../../../layouts/Base.astro";
import { getProduct } from "../../../../lib/api";
import { getCatalog, getProductPaths } from "../../../../lib/catalog";
import { count, money } from "../../../../lib/format";

export async function getStaticPaths() {
  return getProductPaths();
}

const { category: categoryKey, slug } = Astro.params;
const category = (await getCatalog()).categories.find((c) => c.category_key === categoryKey)!;
const { data: product, data_as_of } = await getProduct(slug!);
const name = product.display_name;
const pagePath = `/${categoryKey}/${slug}/`;
---

<Base title={`All ${name} Listings`} description={`All recent ${name} listings on Facebook Marketplace in Canada.`} noindex>
  <Breadcrumb
    items={[
      { label: "Home", href: "/" },
      { label: category.category_name, href: `/${categoryKey}/` },
      { label: name, href: pagePath },
      { label: "All listings" },
    ]}
  />
  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">All {name} listings</h1>
  <p class="mt-2 text-slate-500">
    Asking prices on Facebook Marketplace, all configurations · <LastUpdated iso={data_as_of} />
  </p>
  <div class="mt-6">
    <ProductTabs categoryKey={categoryKey!} slug={slug!} current="listings" />
  </div>

  <section class="mt-6 grid gap-4 sm:grid-cols-3" aria-label="Statistics">
    <StatCard label="Listings in 30 days" value={count(product.listings_30d)} note="comparable listings" />
    <StatCard label="30-day average" value={money(product.avg_price_30d)} note="asking price" />
    <StatCard label="Cheapest 25% under" value={money(product.cutoff_price_cheapest_25pct_30d)} note="30-day price cutoff" />
  </section>

  <section class="mt-8" aria-label="Listings">
    <ListingsTable client:load slug={slug!} />
    <noscript>
      <p class="rounded-xl border border-slate-200 p-5 text-slate-600">This table needs JavaScript to load the listings.</p>
    </noscript>
  </section>

  <p class="mt-8 flex flex-wrap gap-x-6 gap-y-1 text-sm">
    <a href={pagePath}>← Back to the {name} overview</a>
    <a href={`${pagePath}top-deals/`}>See the best deals →</a>
  </p>

</Base>
