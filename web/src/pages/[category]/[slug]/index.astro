---
// A product's overview page: /{category}/{slug}/. The other tabs (market insights, top deals, listings) are sibling folders.
import Breadcrumb from "../../../components/Breadcrumb.astro";
import OverviewChart from "../../../components/charts/OverviewChart";
import DealRow from "../../../components/DealRow.astro";
import LastUpdated from "../../../components/LastUpdated.astro";
import ProductCard from "../../../components/ProductCard.astro";
import ProductTabs from "../../../components/ProductTabs.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import StatCard from "../../../components/StatCard.astro";
import Base from "../../../layouts/Base.astro";
import { getProduct } from "../../../lib/api";
import { getCatalog, getCategoryDeals, getProductPaths, getProductSeries, hasData } from "../../../lib/catalog";
import { count, money, moneyShort } from "../../../lib/format";
import { productSummary } from "../../../lib/text";

// Runs once at build time: lists every page this file must produce, as /{category}/{slug}/.
export async function getStaticPaths() {
  return getProductPaths();
}

const DEALS_SHOWN = 5;

const { category: categoryKey, slug } = Astro.params;
const category = (await getCatalog()).categories.find((c) => c.category_key === categoryKey)!;
const { data: product, data_as_of } = await getProduct(slug!);
const { series } = (await getProductSeries(slug!)).data;

// The API groups the category's deals per product; a product without deals is missing from the answer.
const dealGroups = (await getCategoryDeals(categoryKey!)).data;
const deals = dealGroups.find((group) => group.slug === slug)?.deals.slice(0, DEALS_SHOWN) ?? [];

// The other models of the same category that have a page.
const related = category.products.filter((card) => hasData(card) && card.slug !== slug);

const pagePath = `/${categoryKey}/${slug}/`;
// Kept short: Google shows about 60 characters of a title (the site name is appended by the layout).
const title = `${product.display_name} Price in Canada (${moneyShort(product.avg_price_30d)} avg)`;
const description =
  `${product.display_name} asking prices on Facebook Marketplace in Canada: ` +
  `30-day average ${money(product.avg_price_30d)}, cheapest 25% under ${money(product.cutoff_price_cheapest_25pct_30d)}, ` +
  `from ${product.listings_30d ?? 0} listings.`;
---

<Base title={title} description={description}>
  <Breadcrumb
    items={[
      { label: "Home", href: "/" },
      { label: category.category_name, href: `/${categoryKey}/` },
      { label: product.display_name },
    ]}
  />
  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Used {product.display_name} Price in Canada</h1>
  <p class="mt-2 text-slate-500">
    Asking prices on Facebook Marketplace, all configurations · <LastUpdated iso={data_as_of} />
  </p>
  <div class="mt-6">
    <ProductTabs categoryKey={categoryKey!} slug={slug!} current="overview" />
  </div>
  <p class="mt-6 max-w-3xl text-slate-600">{productSummary(product)}</p>

  <section class="mt-8 grid gap-4 sm:grid-cols-3" aria-label="Statistics">
    <StatCard label="30-day average" value={money(product.avg_price_30d)} note="asking price, last 30 days" />
    <StatCard label="7-day average" value={money(product.avg_price_7d)} note="asking price, last 7 days" />
    <StatCard
      label="Cheapest 25% under"
      value={money(product.cutoff_price_cheapest_25pct_30d)}
      note="30-day price cutoff"
    />
    <StatCard label="Listings in 30 days" value={count(product.listings_30d)} note="comparable listings" />
    <StatCard label="Listings in 7 days" value={count(product.listings_7d)} note="comparable listings" />
    <StatCard
      label="High-scoring listings"
      value={count(product.deal8_listings_30d)}
      note={`deal score 8 or more, 30 days · average ${money(product.deal8_avg_price_30d)}`}
    />
  </section>

  <section class="mt-10">
    <SectionHeading title="Price trend" id="trend" />
    <div class="mt-4">
      <OverviewChart client:visible series={series} />
    </div>
    <p class="mt-3 text-sm">
      <a href={`${pagePath}market-insights/`}>See all charts and choose a period →</a>
    </p>
  </section>

  {
    deals.length > 0 && (
      <section class="mt-10">
        <SectionHeading
          title="Best deals right now"
          id="deals"
          subtitle="The cheapest recent listings, compared with the 30-day average. Availability is not verified."
        />
        <ul class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200">
          {deals.map((deal) => <DealRow deal={deal} />)}
        </ul>
        <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm">
          <a href={`${pagePath}top-deals/`}>See all top deals →</a>
          <a href={`${pagePath}listings/`}>Browse all listings →</a>
        </p>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="mt-12">
        <SectionHeading title={`Other ${category.category_name} models`} id="related" />
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {related.map((card) => <ProductCard card={card} categoryKey={category.category_key} />)}
        </div>
      </section>
    )
  }

</Base>
