---
// A product's overview page: /{category}/{slug}/. The other tabs (market insights, top deals, listings) are sibling folders.
import Breadcrumb from "../../../components/Breadcrumb.astro";
import OverviewChart from "../../../components/charts/OverviewChart";
import DealRow from "../../../components/DealRow.astro";
import LastUpdated from "../../../components/LastUpdated.astro";
import ModelSummaryCard from "../../../components/ModelSummaryCard.astro";
import Sparkline from "../../../components/Sparkline.astro";
import ProductTabs from "../../../components/ProductTabs.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import StatPanel from "../../../components/StatPanel.astro";
import Base from "../../../layouts/Base.astro";
import { byPopularity, getCatalog, getCategoryDeals, getProductPaths, getProductSeries, hasData, getProductSummary } from "../../../lib/catalog";
import { count, money, moneyShort } from "../../../lib/format";
import { averagePrice, fitTitle, formatPct, percentDiff, productSummary, quarterOf, trend30 } from "../../../lib/text";

// Runs once at build time: lists every page this file must produce, as /{category}/{slug}/.
export async function getStaticPaths() {
  return getProductPaths();
}

const DEALS_SHOWN = 5;

const { category: categoryKey, slug } = Astro.params;
const category = (await getCatalog()).categories.find((c) => c.category_key === categoryKey)!;
const { data: product, data_as_of } = await getProductSummary(slug!);
const { series } = (await getProductSeries(slug!)).data;

// The API groups the category's deals per product; a product without deals is missing from the answer.
const dealGroups = (await getCategoryDeals(categoryKey!)).data;
const deals = dealGroups.find((group) => group.slug === slug)?.deals.slice(0, DEALS_SHOWN) ?? [];

// The other models of the same category that have a page.
const otherModels = category.products.filter((card) => hasData(card) && card.slug !== slug);
const related = [...otherModels].sort(byPopularity).slice(0, 4);

const pagePath = `/${categoryKey}/${slug}/`;
const trend = trend30(series);
const last30 = series.slice(-30);
// Kept short: Google shows about 60 characters of a title (the site name is appended by the layout).
const title = fitTitle([
  `${product.display_name} Price in Canada (${moneyShort(product.avg_price_30d)} avg)`,
  `${product.display_name} Price in Canada`,
  `${product.display_name} Price`,
]);
const description =
  `${product.display_name} asking prices on Facebook Marketplace in Canada: ` +
  `30-day average ${money(product.avg_price_30d)}, cheapest 25% under ${money(product.cutoff_price_cheapest_25pct_30d)}, ` +
  `from ${product.listings_30d ?? 0} listings.`;
---

<Base title={title} description={description}>
  <Breadcrumb
    items={[
      { label: "Home", href: "/" },
      { label: category.category_name, href: `/${categoryKey}/` },
      { label: product.display_name },
    ]}
  />

  <header class="relative mt-4 overflow-hidden rounded-3xl bg-gradient-to-br from-blue-700 via-blue-600 to-sky-500 p-6 text-white shadow-lg sm:p-8">
    <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-20 left-1/3 h-48 w-48 rounded-full bg-sky-300/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative grid gap-6 lg:grid-cols-[1.5fr_1fr] lg:items-end">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-white/75">{category.category_name} · Facebook Marketplace, Canada</p>
        <h1 data-pagefind-meta="title" class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Used {product.display_name} Price in Canada</h1>
        <p class="mt-2 text-sm text-white/80">
          Asking prices, all configurations · <LastUpdated iso={data_as_of} />
        </p>
        <p data-pagefind-body class="mt-4 max-w-2xl leading-relaxed text-white/90">{productSummary(product)}</p>
      </div>
      <div class="rounded-2xl bg-white/15 p-4 ring-1 ring-white/25 backdrop-blur">
        <p class="text-xs font-semibold uppercase tracking-wider text-white/75">30-day average</p>
        <div class="mt-1 flex items-end justify-between gap-3">
          <p class="text-4xl font-extrabold tracking-tight">{money(product.avg_price_30d)}</p>
          <Sparkline values={last30.map((day) => day.avg_price_7d)} label={`${product.display_name}: 7-day average price, last 30 days`} width={110} height={44} color="#ffffff" ring="#2563eb" />
        </div>
        {
          trend && (
            <p class="mt-2 text-sm text-white/85">
              <span class="rounded-full bg-white px-2 py-0.5 text-xs font-bold text-slate-900">{formatPct(trend.pct)}</span>
              <span class="ml-1.5">the 7-day average over the last {last30.length} days</span>
            </p>
          )
        }
      </div>
    </div>
  </header>

  <div class="mt-6">
    <ProductTabs categoryKey={categoryKey!} slug={slug!} current="overview" />
  </div>

  <section class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Statistics">
    <StatPanel
      label="30-day average"
      value={moneyShort(product.avg_price_30d)}
      note="CAD, asking price, last 30 days"
      icon="calendar"
      tone="blue"
      spark={last30.map((day) => day.avg_price_30d)}
      sparkLabel="30-day average, last 30 days"
      lines={[{ label: "Listings in 30 days", value: count(product.listings_30d) }]}
    />
    <StatPanel
      label="7-day average"
      value={moneyShort(product.avg_price_7d)}
      note="CAD, asking price, last 7 days"
      icon="trend"
      tone="orange"
      spark={last30.map((day) => day.avg_price_7d)}
      sparkLabel="7-day average, last 30 days"
      lines={[
        { label: "Listings in 7 days", value: count(product.listings_7d) },
        {
          label: "Compared with 30 days",
          value: percentDiff(product.avg_price_7d, product.avg_price_30d) === null ? "n/a" : formatPct(percentDiff(product.avg_price_7d, product.avg_price_30d)!),
        },
      ]}
    />
    <StatPanel
      label="Cheapest 25% under"
      value={moneyShort(product.cutoff_price_cheapest_25pct_30d)}
      note="CAD: a quarter of the listings are priced below this (30 days)"
      icon="tag"
      tone="green"
      spark={last30.map((day) => day.cutoff_price_cheapest_25pct_30d)}
      sparkLabel="Cheapest 25% price, last 30 days"
      lines={[
        { label: "Listings below it", value: quarterOf(product.listings_30d) === null ? "n/a" : `about ${count(quarterOf(product.listings_30d))}` },
        { label: "Same price, 7 days", value: moneyShort(product.cutoff_price_cheapest_25pct_7d) },
      ]}
    />
    <StatPanel
      label="Average of the 5 cheapest"
      value={moneyShort(averagePrice(product.lowest_5_deals_30d))}
      note="the 5 cheapest listings found, last 30 days"
      icon="stack"
      tone="violet"
      spark={last30.map((day) => day.lowest_5_avg_1d)}
      sparkLabel="Average of the 5 cheapest listings, last 30 days"
      lines={[
        { label: "Last 7 days", value: moneyShort(averagePrice(product.lowest_5_deals_7d)) },
        { label: "Cheapest of all (30 days)", value: moneyShort(product.lowest_5_deals_30d?.[0]?.price ?? null) },
      ]}
    />
  </section>

  <section class="mt-10">
    <SectionHeading title="Price trend" id="trend" />
    <div class="mt-4">
      <OverviewChart client:visible series={series} />
    </div>
    <p class="mt-3 text-sm">
      <a href={`${pagePath}market-insights/`}>See all charts and choose a period →</a>
    </p>
  </section>

  {
    deals.length > 0 && (
      <section class="mt-10">
        <SectionHeading
          title="Best deals right now"
          id="deals"
          subtitle="The cheapest recent listings, compared with the 30-day average. Availability is not verified."
        />
        <ul class="mt-4 divide-y divide-slate-200 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          {deals.map((deal) => <DealRow deal={deal} showRank />)}
        </ul>
        <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm">
          <a href={`${pagePath}top-deals/`}>See all top deals →</a>
          <a href={`${pagePath}listings/`}>Browse all listings →</a>
        </p>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="mt-12">
        <SectionHeading title={`Other ${category.category_name} models`} id="related" subtitle="The models with the most listings in the same category." />
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((card) => <ModelSummaryCard card={card} categoryKey={category.category_key} />)}
        </div>
        {otherModels.length > related.length && (
          <p class="mt-4 text-sm">
            <a href={`/${categoryKey}/`}>All {otherModels.length + 1} {category.category_name} models →</a>
          </p>
        )}
      </section>
    )
  }
</Base>
