---
// A product's overview page: /{category}/{slug}/. The other tabs (market insights, top deals, listings) are sibling folders.
import Breadcrumb from "../../../components/Breadcrumb.astro";
import OverviewChart from "../../../components/charts/OverviewChart";
import DealRow from "../../../components/DealRow.astro";
import LastUpdated from "../../../components/LastUpdated.astro";
import ProductCard from "../../../components/ProductCard.astro";
import ProductTabs from "../../../components/ProductTabs.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import StatPanel from "../../../components/StatPanel.astro";
import Base from "../../../layouts/Base.astro";
import { byPopularity, getCatalog, getCategoryDeals, getProductPaths, getProductSeries, hasData, getProductSummary } from "../../../lib/catalog";
import { count, money, moneyShort } from "../../../lib/format";
import { averagePrice, fitTitle, formatPct, percentDiff, productSummary, quarterOf } from "../../../lib/text";

// Runs once at build time: lists every page this file must produce, as /{category}/{slug}/.
export async function getStaticPaths() {
  return getProductPaths();
}

const DEALS_SHOWN = 5;

const { category: categoryKey, slug } = Astro.params;
const category = (await getCatalog()).categories.find((c) => c.category_key === categoryKey)!;
const { data: product, data_as_of } = await getProductSummary(slug!);
const { series } = (await getProductSeries(slug!)).data;

// The API groups the category's deals per product; a product without deals is missing from the answer.
const dealGroups = (await getCategoryDeals(categoryKey!)).data;
const deals = dealGroups.find((group) => group.slug === slug)?.deals.slice(0, DEALS_SHOWN) ?? [];

// The other models of the same category that have a page.
const otherModels = category.products.filter((card) => hasData(card) && card.slug !== slug);
const related = [...otherModels].sort(byPopularity).slice(0, 4);

const pagePath = `/${categoryKey}/${slug}/`;
// Kept short: Google shows about 60 characters of a title (the site name is appended by the layout).
const title = fitTitle([
  `${product.display_name} Price in Canada (${moneyShort(product.avg_price_30d)} avg)`,
  `${product.display_name} Price in Canada`,
  `${product.display_name} Price`,
]);
const description =
  `${product.display_name} asking prices on Facebook Marketplace in Canada: ` +
  `30-day average ${money(product.avg_price_30d)}, cheapest 25% under ${money(product.cutoff_price_cheapest_25pct_30d)}, ` +
  `from ${product.listings_30d ?? 0} listings.`;
---

<Base title={title} description={description}>
  <Breadcrumb
    items={[
      { label: "Home", href: "/" },
      { label: category.category_name, href: `/${categoryKey}/` },
      { label: product.display_name },
    ]}
  />
  <h1 data-pagefind-meta="title" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Used {product.display_name} Price in Canada</h1>
  <p class="mt-2 text-slate-500">
    Asking prices on Facebook Marketplace, all configurations · <LastUpdated iso={data_as_of} />
  </p>
  <div class="mt-6">
    <ProductTabs categoryKey={categoryKey!} slug={slug!} current="overview" />
  </div>
  <p data-pagefind-body class="mt-6 max-w-3xl text-slate-600">{productSummary(product)}</p>

  <section class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Statistics">
    <StatPanel
      label="30-day average"
      value={money(product.avg_price_30d)}
      note="asking price, last 30 days"
      icon="calendar"
      tone="blue"
      lines={[{ label: "Listings in 30 days", value: count(product.listings_30d) }]}
    />
    <StatPanel
      label="7-day average"
      value={money(product.avg_price_7d)}
      note="asking price, last 7 days"
      icon="trend"
      tone="orange"
      lines={[
        { label: "Listings in 7 days", value: count(product.listings_7d) },
        {
          label: "Compared with 30 days",
          value: percentDiff(product.avg_price_7d, product.avg_price_30d) === null ? "n/a" : formatPct(percentDiff(product.avg_price_7d, product.avg_price_30d)!),
        },
      ]}
    />
    <StatPanel
      label="Cheapest 25% under"
      value={money(product.cutoff_price_cheapest_25pct_30d)}
      note="a quarter of the listings are priced below this (30 days)"
      icon="tag"
      tone="green"
      lines={[
        { label: "Listings below it", value: quarterOf(product.listings_30d) === null ? "n/a" : `about ${count(quarterOf(product.listings_30d))}` },
        { label: "Same price, 7 days", value: moneyShort(product.cutoff_price_cheapest_25pct_7d) },
      ]}
    />
    <StatPanel
      label="Average of the 5 cheapest"
      value={moneyShort(averagePrice(product.lowest_5_deals_30d))}
      note="the 5 cheapest listings found, last 30 days"
      icon="stack"
      tone="violet"
      lines={[
        { label: "Last 7 days", value: moneyShort(averagePrice(product.lowest_5_deals_7d)) },
        { label: "Cheapest of all (30 days)", value: moneyShort(product.lowest_5_deals_30d?.[0]?.price ?? null) },
      ]}
    />
  </section>

  <section class="mt-10">
    <SectionHeading title="Price trend" id="trend" />
    <div class="mt-4">
      <OverviewChart client:visible series={series} />
    </div>
    <p class="mt-3 text-sm">
      <a href={`${pagePath}market-insights/`}>See all charts and choose a period →</a>
    </p>
  </section>

  {
    deals.length > 0 && (
      <section class="mt-10">
        <SectionHeading
          title="Best deals right now"
          id="deals"
          subtitle="The cheapest recent listings, compared with the 30-day average. Availability is not verified."
        />
        <ul class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200">
          {deals.map((deal) => <DealRow deal={deal} />)}
        </ul>
        <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm">
          <a href={`${pagePath}top-deals/`}>See all top deals →</a>
          <a href={`${pagePath}listings/`}>Browse all listings →</a>
        </p>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="mt-12">
        <SectionHeading title={`Other ${category.category_name} models`} id="related" />
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {related.map((card) => <ProductCard card={card} categoryKey={category.category_key} />)}
        </div>
        {otherModels.length > related.length && (
          <p class="mt-4 text-sm">
            <a href={`/${categoryKey}/`}>All {otherModels.length + 1} {category.category_name} models →</a>
          </p>
        )}
      </section>
    )
  }

</Base>
