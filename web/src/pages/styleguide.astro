---
// Developer-only page: every shared component, in every variant, on one page. noindex, and it must stay out of the sitemap
// (and be removed or hidden before launch). Open it at /styleguide/.
import ProductCharts from "../components/charts/ProductCharts";
import OverviewChart from "../components/charts/OverviewChart";
import Sparkline from "../components/Sparkline.astro";
import AdSlot from "../components/AdSlot.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Disclosure from "../components/Disclosure.astro";
import LastUpdated from "../components/LastUpdated.astro";
import PriceBadge from "../components/PriceBadge.astro";
import ProductCard from "../components/ProductCard.astro";
import ProductTabs from "../components/ProductTabs.astro";
import SectionHeading from "../components/SectionHeading.astro";
import StatCard from "../components/StatCard.astro";
import Base from "../layouts/Base.astro";
import { getProduct, getSeries } from "../lib/api";
import { getCatalog, hasData } from "../lib/catalog";
import { PRODUCT_TABS } from "../lib/site";
import { productSummary } from "../lib/text";

// Real data for the samples: the first product that has a page.
const { categories, data_as_of } = await getCatalog();
const category = categories.find((c) => c.products.some(hasData))!;
const card = category.products.find(hasData)!;
const { data: product } = await getProduct(card.slug);
const { series } = (await getSeries(card.slug)).data;
---

<Base title="Style guide" description="Internal page showing the shared components." noindex>
  <h1 class="text-3xl font-bold tracking-tight">Style guide</h1>
  <p class="mt-2 text-slate-500">
    Every shared component on one page. Internal only (noindex, not in the sitemap). Sample data: {product.display_name}.
  </p>

  <div class="mt-10 space-y-12">
    <section class="space-y-4">
      <SectionHeading title="SectionHeading" subtitle="h2 with a subtitle and an id you can link to" id="section-heading" />
      <SectionHeading title="A smaller h3 heading" level="h3" />
    </section>

    <section class="space-y-4">
      <SectionHeading title="Breadcrumb" subtitle="Also writes BreadcrumbList structured data (view the page source)" />
      <Breadcrumb items={[{ label: "Home", href: "/" }, { label: category.category_name, href: `/${category.category_key}/` }, { label: product.display_name }]} />
    </section>

    <section class="space-y-4">
      <SectionHeading title="ProductTabs" subtitle="One example per current tab" />
      {PRODUCT_TABS.map((tab) => <ProductTabs categoryKey={category.category_key} slug={card.slug} current={tab.key} />)}
    </section>

    <section class="space-y-4">
      <SectionHeading title="StatCard and PriceBadge" />
      <div class="grid gap-4 sm:grid-cols-3">
        <StatCard label="30-day average" value="$1,111 CAD" note="939 listings" />
        <StatCard label="No note" value="$1,000 CAD" />
        <div class="flex items-center gap-2 rounded-xl border border-slate-200 p-5">
          <PriceBadge diff={-235} />
          <PriceBadge diff={80} />
          <PriceBadge diff={0} />
        </div>
      </div>
    </section>

    <section class="space-y-4">
      <SectionHeading title="ProductCard" />
      <div class="grid gap-4 sm:grid-cols-2">
        <ProductCard card={card} categoryKey={category.category_key} />
        <ProductCard card={{ ...card, avg_price_30d: null }} categoryKey={category.category_key} />
      </div>
    </section>

    <section class="space-y-4">
      <SectionHeading title="LastUpdated and generated text" subtitle="lib/text.ts builds this paragraph from the numbers" />
      <p class="text-sm text-slate-500"><LastUpdated iso={data_as_of} /></p>
      <p class="max-w-3xl text-slate-600">{productSummary(product)}</p>
    </section>

    <section class="space-y-4">
      <SectionHeading title="Disclosure" />
      <Disclosure />
      <Disclosure variant="affiliate" />
    </section>

    <section class="space-y-4">
      <SectionHeading title="Sparkline" subtitle="Plain SVG made at build time (no JavaScript)" />
      <div class="flex items-center gap-6">
        <Sparkline values={series.slice(-7).map((p) => p.avg_price_1d)} label="Average price, last 7 days" />
        <Sparkline values={series.slice(-30).map((p) => p.avg_price_7d)} label="7-day average, last 30 days" width={200} />
      </div>
    </section>

    <section class="space-y-4">
      <SectionHeading title="OverviewChart" subtitle="The fixed 15-day chart of the overview page (a React island)" />
      <OverviewChart client:visible series={series} />
    </section>

    <section class="space-y-4">
      <SectionHeading title="ProductCharts" subtitle="All charts of the insights page, with the period filter" />
      <ProductCharts client:visible series={series} />
    </section>

    <section>
      <SectionHeading title="AdSlot" subtitle="Rendered nothing on real pages while ADS_ENABLED is false; shown here with preview" />
      <AdSlot slot="styleguide-banner" preview />
      <AdSlot slot="styleguide-rectangle" size="rectangle" preview />
    </section>
  </div>
</Base>
