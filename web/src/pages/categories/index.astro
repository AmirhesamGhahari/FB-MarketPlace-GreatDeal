---
// /categories/: every category as a big card. The top-bar "Products" link leads here.
import Breadcrumb from "../../components/Breadcrumb.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import Carousel from "../../components/Carousel.astro";
import Base from "../../layouts/Base.astro";
import { aroundCenter, getCatalog, hasData, sortCategoriesByListings } from "../../lib/catalog";
import { formatDateTime } from "../../lib/format";

const { categories: all, data_as_of } = await getCatalog();
// The category with the most listings in the middle, the others around it in order.
const modelCount = all.reduce((sum, category) => sum + category.products.filter(hasData).length, 0);
const { items: categories, center } = aroundCenter(await sortCategoriesByListings(all));

// Backgrounds, used in turn; photos replace them in step F12.
const gradients = [
  "from-blue-700 to-sky-600",
  "from-indigo-700 to-violet-600",
  "from-teal-700 to-emerald-600",
  "from-slate-800 to-slate-600",
];
---

<Base
  title="Used Electronics Prices in Canada by Category"
  description="Browse used electronics by category: average asking prices, price trends and the best current deals from Facebook Marketplace listings in Canada."
>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Categories" }]} />
  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">Used Electronics Prices in Canada by Category</h1>
  <div class="mt-3 max-w-3xl space-y-3 text-lg text-slate-600">
    <p>
      Pick a category to compare what people are really asking for used models on Facebook Marketplace. {modelCount} models
      in {all.length} categories, and every one has its own price history, a "cheapest 25% under" yardstick and a list of the
      cheapest deals, so you can tell a fair price from a bargain before you message a seller.
    </p>
    <p>Prices are asking prices in Canadian dollars, updated after each data refresh ({formatDateTime(data_as_of)}).</p>
  </div>

  <div class="mt-6">
    <Carousel label="Categories">
      {
        categories.map((category, index) => (
          <li data-carousel-item data-carousel-start={index === center ? "" : undefined}>
            <CategoryCard category={category} gradient={gradients[all.indexOf(category) % gradients.length]} variant="categories" />
          </li>
        ))
      }
    </Carousel>
  </div>
</Base>
