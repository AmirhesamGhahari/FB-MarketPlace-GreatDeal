---
// The frame of a text page (About, How it works, Privacy, ...): a readable column with plain headings, paragraphs and lists.
import Breadcrumb from "../components/Breadcrumb.astro";
import Base from "./Base.astro";

interface Props {
  title: string; // the page title (and the H1 unless `h1` is given)
  h1?: string;
  description: string;
  intro?: string; // one sentence under the H1
  updated?: string; // "November 20, 2026", for pages whose wording is dated (Privacy, Terms)
  searchable?: boolean; // true: the site search finds this page (About, How it works)
}

const { title, h1, description, intro, updated, searchable = false } = Astro.props;
---

<Base title={title} description={description}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label: title }]} />
  <article class="text-page mt-4 max-w-3xl" data-pagefind-body={searchable ? "" : undefined}>
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{h1 ?? title}</h1>
    {intro && <p class="mt-3 text-lg text-slate-600">{intro}</p>}
    {updated && <p class="mt-2 text-sm text-slate-500">Last updated {updated}</p>}
    <div class="mt-8">
      <slot />
    </div>
  </article>
</Base>

<style>
  /* Plain styling for the headings, paragraphs and lists written inside the slot (they are outside this component's own
     markup, so :global is needed). */
  .text-page :global(h2) {
    margin-top: 2.25rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #0f172a;
  }
  .text-page :global(p),
  .text-page :global(li) {
    margin-top: 0.75rem;
    line-height: 1.7;
    color: #475569;
  }
  .text-page :global(ul) {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .text-page :global(dt) {
    margin-top: 1rem;
    font-weight: 600;
    color: #0f172a;
  }
  .text-page :global(dd) {
    margin-top: 0.25rem;
    line-height: 1.7;
    color: #475569;
  }
</style>
