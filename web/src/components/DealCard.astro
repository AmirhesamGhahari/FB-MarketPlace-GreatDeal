---
// One deal as a card (home page): the model, the price, how far below its 30-day average, and the listing's title and place.
import type { Deal } from "../lib/api";
import { formatDate, formatPriceDiff, money } from "../lib/format";
import PriceBadge from "./PriceBadge.astro";

interface Props {
  deal: Deal;
  productName: string;
}

const { deal, productName } = Astro.props;
const details = [deal.location_city, deal.condition && deal.condition !== "Unknown" ? deal.condition : null, `Listed ${formatDate(deal.listed_at)}`];
---

<article class="flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <p class="text-sm font-medium text-slate-500">{productName}</p>
  <div class="mt-2 flex flex-wrap items-center gap-3">
    <span class="text-3xl font-semibold tracking-tight text-slate-900">{money(deal.price)}</span>
    <PriceBadge diff={deal.price_diff_30d} />
  </div>
  {
    deal.price_diff_30d !== null && deal.avg_price_30d !== null && (
      <p class="mt-1 text-sm text-slate-500">
        {formatPriceDiff(deal.price_diff_30d)} compared with the 30-day average of {money(deal.avg_price_30d)}
      </p>
    )
  }
  <p class="mt-4 line-clamp-2 font-medium text-slate-900">{deal.title ?? "Untitled listing"}</p>
  <p class="mt-1 text-sm text-slate-500">{details.filter(Boolean).join(" · ")}</p>
  {deal.listing_url && <a href={deal.listing_url} target="_blank" rel="nofollow noopener noreferrer" class="mt-auto pt-4 text-sm font-medium">View on Facebook →</a>}
</article>
