---
// A compact card for one model, used for "Other models" at the end of a model page: the 30-day average with its trend, a small
// chart, and four numbers. The whole card is a link to the model's page.
import type { CategoryProductCard } from "../lib/api";
import { count, moneyShort } from "../lib/format";
import { getProductSeries } from "../lib/catalog";
import { formatPct, trend30 } from "../lib/text";
import Sparkline from "./Sparkline.astro";

interface Props {
  card: CategoryProductCard;
  categoryKey: string;
}

const { card, categoryKey } = Astro.props;
const { series } = (await getProductSeries(card.slug)).data;
const trend = trend30(series);
const rounded = trend ? Math.round(trend.pct) : 0;
---

<a
  href={`/${categoryKey}/${card.slug}/`}
  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-5 text-slate-900 no-underline shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:no-underline"
>
  <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-blue-500 to-sky-400" aria-hidden="true"></div>
  <h3 class="text-base font-bold leading-snug text-slate-900">{card.display_name}</h3>
  <div class="mt-3 flex items-end justify-between gap-2">
    <div>
      <p class="text-[11px] text-slate-500">30-day average</p>
      <p class="text-2xl font-extrabold tracking-tight">{moneyShort(card.avg_price_30d)}</p>
    </div>
    {
      trend && (
        <span
          class:list={[
            "rounded-full px-2.5 py-1 text-sm font-bold",
            rounded < 0 ? "bg-good-bg text-good" : rounded > 0 ? "bg-bad-bg text-bad" : "bg-slate-100 text-slate-600",
          ]}
        >
          {formatPct(trend.pct)}
        </span>
      )
    }
  </div>
  <div class="mt-2">
    <Sparkline values={series.slice(-30).map((day) => day.avg_price_7d)} label={`${card.display_name}: 7-day average price, last 30 days`} width={190} height={40} />
  </div>
  <dl class="mt-3 grid grid-cols-3 gap-2 rounded-xl bg-slate-50 p-2.5 text-center">
    <div>
      <dd class="text-sm font-bold tabular-nums">{moneyShort(card.avg_price_7d)}</dd>
      <dt class="text-[10px] leading-tight text-slate-500">7-day avg</dt>
    </div>
    <div>
      <dd class="text-sm font-bold tabular-nums">{moneyShort(card.cutoff_price_cheapest_25pct_30d)}</dd>
      <dt class="text-[10px] leading-tight text-slate-500">cheapest 25%</dt>
    </div>
    <div>
      <dd class="text-sm font-bold tabular-nums">{count(card.listings_30d)}</dd>
      <dt class="text-[10px] leading-tight text-slate-500">listings, 30 days</dt>
    </div>
  </dl>
  <span class="mt-auto pt-3 text-sm font-semibold text-brand-700 group-hover:underline">View {card.display_name} →</span>
</a>
