---
// A short notice for the page body. "affiliate" goes next to affiliate links (needed before any are added); "prices" is the
// same wording as the footer and is not used on the pages (the footer already carries it), only shown in the style guide.
interface Props {
  variant?: "prices" | "affiliate";
}

const { variant = "prices" } = Astro.props;
---

<p class="rounded-lg bg-slate-50 px-4 py-3 text-sm text-slate-500">
  {
    variant === "prices" ? (
      <>
        These are asking prices from Facebook Marketplace listings, not sold prices, and availability is not verified.{" "}
        <a href="/how-it-works/">How we calculate the numbers</a>
      </>
    ) : (
      <>Some links on this page are affiliate links: we may earn a commission if you buy through them, at no extra cost to you.</>
    )
  }
</p>
