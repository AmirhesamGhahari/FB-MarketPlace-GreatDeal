---
// The extra panel of a card: two tiny 7-day charts (average price and listings per day) and/or the best deals. On a mouse
// device it opens under the card when the card (the element with class "group") is hovered or focused; on touch screens,
// which cannot hover, it is shown below the card. Needs to sit inside a `group relative` wrapper.
import type { Deal, SeriesPoint } from "../lib/api";
import { moneyShort } from "../lib/format";
import DealRow from "./DealRow.astro";
import Sparkline from "./Sparkline.astro";

interface Props {
  name: string; // the product, for the chart descriptions read by screen readers
  last7?: SeriesPoint[]; // the last 7 full days, oldest first; leave out for a deals-only panel
  deals?: Deal[];
}

const { name, last7, deals = [] } = Astro.props;
const showCharts = last7 !== undefined && last7.length >= 2;
const prices = (last7 ?? []).map((day) => day.avg_price_1d);
const listings = (last7 ?? []).map((day) => day.listings_1d);
const lastKnown = (values: (number | null)[]) => values.findLast((v) => v !== null) ?? null;
---

{
  (showCharts || deals.length > 0) && (
    <div class="mt-3 [@media(hover:hover)]:absolute [@media(hover:hover)]:inset-x-0 [@media(hover:hover)]:top-full [@media(hover:hover)]:z-20 [@media(hover:hover)]:mt-0 [@media(hover:hover)]:hidden [@media(hover:hover)]:pt-2 group-hover:block group-focus-within:block">
      <div class="rounded-xl border border-slate-200 bg-white p-4 [@media(hover:hover)]:shadow-lg">
        {showCharts && (
          <>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Last 7 days</p>
            <div class="mt-3 grid gap-4 sm:grid-cols-2">
              <div>
                <p class="text-sm text-slate-500">Average price per day</p>
                <div class="mt-1 flex items-center justify-between gap-3">
                  <Sparkline values={prices} label={`${name}: average price per day, last 7 days`} />
                  <span class="text-sm font-medium text-slate-900">{moneyShort(lastKnown(prices))}</span>
                </div>
              </div>
              <div>
                <p class="text-sm text-slate-500">Listings per day</p>
                <div class="mt-1 flex items-center justify-between gap-3">
                  <Sparkline values={listings} label={`${name}: listings per day, last 7 days`} />
                  <span class="text-sm font-medium text-slate-900">{lastKnown(listings) ?? "n/a"}</span>
                </div>
              </div>
            </div>
          </>
        )}
        {deals.length > 0 && (
          <>
            <p class:list={["text-xs font-semibold uppercase tracking-wide text-slate-500", showCharts && "mt-4"]}>Best deals now</p>
            <ul class="mt-1 divide-y divide-slate-100">{deals.map((deal) => <DealRow deal={deal} compact />)}</ul>
          </>
        )}
      </div>
    </div>
  )
}
