---
// A headline number in a card with a coloured accent, an icon, and a few supporting lines. Used on the model overview and
// listings pages.
interface Props {
  label: string;
  value: string;
  note?: string; // one line under the number
  lines?: { label: string; value: string }[]; // supporting figures
  tone?: "blue" | "orange" | "green" | "violet";
  icon?: "trend" | "calendar" | "tag" | "stack";
}

const { label, value, note, lines = [], tone = "blue", icon = "trend" } = Astro.props;

// Complete class names, so Tailwind can find them.
const tones = {
  blue: { bar: "from-blue-500 to-sky-400", bubble: "bg-blue-50 text-blue-600" },
  orange: { bar: "from-orange-500 to-amber-400", bubble: "bg-orange-50 text-orange-600" },
  green: { bar: "from-emerald-500 to-teal-400", bubble: "bg-emerald-50 text-emerald-600" },
  violet: { bar: "from-violet-500 to-fuchsia-400", bubble: "bg-violet-50 text-violet-600" },
};
const paths = {
  trend: "M3 17l6-6 4 4 8-8M15 7h6v6",
  calendar: "M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 011 1v13a1 1 0 01-1 1H5a1 1 0 01-1-1V6a1 1 0 011-1z",
  tag: "M3 12l9-9h8v8l-9 9-8-8zM15.5 8.5h.01",
  stack: "M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5M3 17l9 5 9-5",
};
const style = tones[tone];
---

<div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class={`absolute inset-x-0 top-0 h-1 bg-gradient-to-r ${style.bar}`}></div>
  <div class="flex items-center gap-3">
    <span class={`flex h-9 w-9 items-center justify-center rounded-xl ${style.bubble}`}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d={paths[icon]}></path>
      </svg>
    </span>
    <p class="text-sm font-medium text-slate-500">{label}</p>
  </div>
  <p class="mt-4 text-3xl font-bold tracking-tight text-slate-900">{value}</p>
  {note && <p class="mt-1 text-sm text-slate-500">{note}</p>}
  {
    lines.length > 0 && (
      <dl class="mt-4 space-y-1.5 border-t border-slate-100 pt-3 text-sm">
        {lines.map((line) => (
          <div class="flex items-baseline justify-between gap-3">
            <dt class="text-slate-500">{line.label}</dt>
            <dd class="font-semibold tabular-nums text-slate-800">{line.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
</div>
