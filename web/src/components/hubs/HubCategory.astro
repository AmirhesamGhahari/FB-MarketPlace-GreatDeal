---
// The page of a section for one category (/market-insights/iphone/, ...): a card per model, each leading to the model's page of
// that section.
import Breadcrumb from "../Breadcrumb.astro";
import Carousel from "../Carousel.astro";
import ModelColumn from "../ModelColumn.astro";
import Base from "../../layouts/Base.astro";
import { aroundCenter, byPopularity, getCatalog, getCategoryDeals, getProductSeries, hasData } from "../../lib/catalog";
import LastUpdated from "../LastUpdated.astro";
import { HUBS, type HubKey } from "../../lib/site";
import { categoryValues, pageMeta, type PageKey } from "../../lib/seo";
import { dealStats, dealsHubSentences, insightsCategorySentences, plural, trend30, trendCounts } from "../../lib/text";

interface Props {
  hub: HubKey;
  categoryKey: string;
}

const { hub, categoryKey } = Astro.props;
const { label, noindex } = HUBS[hub];
const { categories, data_as_of } = await getCatalog();
const category = categories.find((c) => c.category_key === categoryKey)!;
const name = category.category_name;
const cards = category.products.filter(hasData);
// The model with the most listings in the middle of the carousel, the others around it in order.
const arranged = aroundCenter([...cards].sort(byPopularity));

// Data per model, depending on the section.
const seriesBySlug = new Map<string, Awaited<ReturnType<typeof getProductSeries>>["data"]["series"]>();
if (hub === "market-insights") {
  for (const card of cards) seriesBySlug.set(card.slug, (await getProductSeries(card.slug)).data.series);
}
const dealGroups = hub === "top-deals" ? (await getCategoryDeals(categoryKey)).data : [];
const dealsFor = (slug: string) => dealGroups.find((group) => group.slug === slug)?.deals ?? [];

let sentences: string[] = [];
const metaValues: Record<string, string | number | null | undefined> = categoryValues(name, cards);
if (hub === "market-insights") {
  const items = cards.flatMap((card) => {
    const trend = trend30(seriesBySlug.get(card.slug) ?? []);
    return trend ? [{ name: card.display_name, pct: trend.pct }] : [];
  });
  sentences = insightsCategorySentences(name, items);
  const counts = trendCounts(items);
  Object.assign(metaValues, { n_fell: counts.fell, n_rose: counts.rose, n_steady: counts.steady });
} else if (hub === "top-deals") {
  const items = cards.flatMap((card) => (dealsFor(card.slug)[0] ? [{ name: card.display_name, deal: dealsFor(card.slug)[0] }] : []));
  sentences = dealsHubSentences(plural(items.length, `${name} model`, `${name} models`), items);
  const stats = dealStats(items);
  Object.assign(metaValues, { n_models: items.length, median_gap_pct: stats.median, n_deep: stats.deep });
} else {
  const listings = cards.reduce((sum, card) => sum + (card.listings_30d ?? 0), 0);
  sentences = [
    `That is ${plural(listings, "listing", "listings")} from the last 30 days across ${plural(cards.length, "model", "models")}.`,
    "Sort by price to see the cheapest first and how far each one sits below its model's average, a quick way to learn what a good price is.",
  ];
}

const metaKeys: Record<HubKey, PageKey> = {
  "market-insights": "hub_market_insights_category",
  "top-deals": "hub_top_deals_category",
  "all-listings": "hub_all_listings_category",
};
const meta = pageMeta(metaKeys[hub], metaValues);
const intros = {
  "market-insights": `How asking prices and listings changed for used ${name} models on Facebook Marketplace in Canada. Pick a model for its full price history.`,
  "top-deals": `The best current deals on used ${name} models on Facebook Marketplace in Canada, compared with each model's 30-day average. Pick a model for its full list.`,
  "all-listings": `Every recent listing for used ${name} models. Pick a model to browse, sort and filter its listings.`,
};
---

<Base title={meta.title} description={meta.description} noindex={noindex}>
  <Breadcrumb items={[{ label: "Home", href: "/" }, { label, href: `/${hub}/` }, { label: name }]} />
  <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{meta.h1}</h1>
  <p class="mt-3 max-w-3xl text-lg text-slate-600">{intros[hub]} {sentences.join(" ")}</p>
  <p class="mt-2 text-sm text-slate-500"><LastUpdated iso={data_as_of} /></p>

  <div class="mt-6">
    <Carousel label={`${name} models`}>
      {
        arranged.items.map((card, index) => (
          <li data-carousel-item data-carousel-start={index === arranged.center ? "" : undefined}>
            <ModelColumn variant={hub} card={card} categoryKey={categoryKey} />
          </li>
        ))
      }
    </Carousel>
  </div>

  <p class="mt-8 flex flex-wrap gap-x-6 gap-y-1 text-sm">
    <a href={`/${hub}/`}>← {label}: all categories</a>
    <a href={`/${categoryKey}/`}>{name} overview →</a>
  </p>
</Base>
