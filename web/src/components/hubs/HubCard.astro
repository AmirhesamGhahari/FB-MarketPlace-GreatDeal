---
// One model on a hub page (/market-insights/iphone/, /top-deals/iphone/, /all-listings/iphone/). The whole card links to the
// model's page of that section. What it shows depends on the section (`variant`); the extra panel opens on hover for mouse
// devices and is shown inline on touch screens (see CardPreview).
import type { CategoryProductCard, Deal, SeriesPoint } from "../../lib/api";
import { count, money } from "../../lib/format";
import { formatPct, trend30 } from "../../lib/text";
import { HUBS, PRODUCT_TABS, type HubKey } from "../../lib/site";
import CardPreview from "../CardPreview.astro";
import PriceBadge from "../PriceBadge.astro";
import Sparkline from "../Sparkline.astro";

interface Props {
  variant: HubKey;
  card: CategoryProductCard;
  categoryKey: string;
  series?: SeriesPoint[]; // the product's series (insights cards)
  deals?: Deal[]; // the product's top deals, best first (deals cards)
}

const { variant, card, categoryKey, series = [], deals = [] } = Astro.props;
const tabPath = PRODUCT_TABS.find((tab) => tab.key === HUBS[variant].tab)!.path;
const href = `/${categoryKey}/${card.slug}/${tabPath}`;

const trend = variant === "market-insights" ? trend30(series) : null;
const best = deals[0];
---

<div class="group relative">
  <a
    href={href}
    class="block rounded-xl border border-slate-200 bg-white p-5 shadow-sm no-underline transition hover:border-brand-600 hover:shadow-md hover:no-underline group-focus-within:border-brand-600"
  >
    <h3 class="text-lg font-semibold tracking-tight text-slate-900">{card.display_name}</h3>

    {
      variant === "market-insights" && (
        <>
          <p class="mt-3 text-sm text-slate-500">7-day average, last 30 days</p>
          <div class="mt-1 flex items-center justify-between gap-4">
            {trend ? (
              <span
                class:list={[
                  "inline-block rounded-full px-2.5 py-0.5 text-sm font-semibold",
                  trend.pct < 0 ? "bg-good-bg text-good" : trend.pct > 0 ? "bg-bad-bg text-bad" : "bg-slate-100 text-slate-600",
                ]}
              >
                {formatPct(trend.pct)}
              </span>
            ) : (
              <span class="text-sm text-slate-400">n/a</span>
            )}
            <Sparkline
              values={series.slice(-30).map((day) => day.avg_price_7d)}
              label={`${card.display_name}: 7-day average price, last 30 days`}
              width={200}
              height={40}
            />
          </div>
          <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
            <div>
              <dt class="text-slate-500">30-day average</dt>
              <dd class="font-medium text-slate-900">{money(card.avg_price_30d)}</dd>
            </div>
            <div>
              <dt class="text-slate-500">Listings in 30 days</dt>
              <dd class="font-medium text-slate-900">{count(card.listings_30d)}</dd>
            </div>
          </dl>
        </>
      )
    }

    {
      variant === "top-deals" &&
        (best ? (
          <>
            <p class="mt-3 text-sm text-slate-500">Best deal right now</p>
            <div class="flex flex-wrap items-center gap-3">
              <span class="text-3xl font-semibold tracking-tight text-slate-900">{money(best.price)}</span>
              <PriceBadge diff={best.price_diff_30d} />
            </div>
            <p class="mt-2 truncate text-sm text-slate-600">{best.title ?? "Untitled listing"}</p>
            <p class="mt-3 text-sm text-slate-500">
              {deals.length} top deals · 30-day average {money(card.avg_price_30d)}
            </p>
          </>
        ) : (
          <p class="mt-3 text-sm text-slate-500">No deals right now.</p>
        ))
    }

    {
      variant === "all-listings" && (
        <>
          <p class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">{count(card.listings_30d)}</p>
          <p class="text-sm text-slate-500">listings in the last 30 days</p>
          <p class="mt-3 text-sm text-slate-500">30-day average {money(card.avg_price_30d)}</p>
        </>
      )
    }
  </a>

  {variant === "market-insights" && series.length >= 8 && <CardPreview name={card.display_name} last7={series.slice(-8, -1)} />}
  {variant === "top-deals" && <CardPreview name={card.display_name} deals={deals.slice(0, 3)} />}
</div>
