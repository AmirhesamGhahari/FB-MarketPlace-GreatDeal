---
// One category as a tall column on a colour gradient (photos come later), for the carousels on /categories/ and on the roots of
// the sections: the name, a line of text, how many models and listings (last 7 and 30 days) the category has, and its most-listed
// models with the numbers that fit the page (`variant`). The whole column is a link to the category's page (the title link is
// stretched over it) and the model links sit above that.
import type { CatalogCategory } from "../lib/catalog";
import { byPopularity, getCategoryDeals, getCategoryTotals, hasData } from "../lib/catalog";
import { count, moneyShort } from "../lib/format";

interface Props {
  category: CatalogCategory;
  gradient: string; // Tailwind gradient classes, for example "from-blue-700 to-sky-600"
  variant?: "categories" | "market-insights" | "top-deals" | "all-listings";
  href?: string; // where the column leads (default: the category page)
  modelPath?: string; // appended to /{category}/{slug}/ for the model links ("" = the overview, "top-deals/" = the deals page)
  blurb?: string; // the line of text under the title
}

const { category, gradient, variant = "categories", href = `/${category.category_key}/`, modelPath = "", blurb } = Astro.props;
const models = category.products.filter(hasData);
// A category can have many models: the column lists the ones with the most listings and links to the rest.
const MAX_MODELS = 8;
const shownModels = [...models].sort(byPopularity).slice(0, MAX_MODELS);
const totals = await getCategoryTotals(category);
// For the deals page: how many deals each model has and their average price.
const dealGroups = variant === "top-deals" ? (await getCategoryDeals(category.category_key)).data : [];
const dealsOf = (slug: string) => dealGroups.find((group) => group.slug === slug)?.deals ?? [];
const average = (values: number[]) => (values.length === 0 ? null : values.reduce((a, b) => a + b, 0) / values.length);

const name = category.category_name;
const link = "relative z-10 text-white no-underline hover:text-white hover:underline";
---

<article class={`relative flex h-full min-h-[34rem] flex-col overflow-hidden rounded-2xl bg-gradient-to-br ${gradient} p-5 text-white shadow-sm`}>
  <h2 class="text-3xl font-bold tracking-tight">
    <a href={href} class="text-white no-underline hover:text-white hover:no-underline after:absolute after:inset-0">{name}</a>
  </h2>
  <p class="mt-3 text-sm leading-relaxed text-white/90">
    {blurb ?? `Average asking prices, price trends and the best current deals for used ${name} models in Canada.`}
  </p>
  <dl class="mt-4 grid grid-cols-3 gap-2 rounded-xl bg-black/15 p-3 text-center">
    <div>
      <dd class="text-xl font-bold leading-none">{totals.models}</dd>
      <dt class="mt-1 text-[11px] leading-tight text-white/75">{totals.models === 1 ? "model" : "models"}</dt>
    </div>
    <div>
      <dd class="text-xl font-bold leading-none">{count(totals.listings7d)}</dd>
      <dt class="mt-1 text-[11px] leading-tight text-white/75">listings, 7 days</dt>
    </div>
    <div>
      <dd class="text-xl font-bold leading-none">{count(totals.listings30d)}</dd>
      <dt class="mt-1 text-[11px] leading-tight text-white/75">listings, 30 days</dt>
    </div>
  </dl>

  <p class="mt-5 text-xs font-semibold uppercase tracking-wide text-white/70">Most listed</p>
  <ul class="mt-2 space-y-2">
    {
      shownModels.map((product) => {
        const deals = dealsOf(product.slug);
        const stats =
          variant === "top-deals"
            ? [
                ["Deals", deals.length > 0 ? String(deals.length) : "none"],
                ["Average of the top deals", moneyShort(average(deals.map((deal) => deal.price)))],
                ["30-day average", moneyShort(product.avg_price_30d)],
                ["Listings, 30 days", count(product.listings_30d)],
              ]
            : variant === "all-listings"
              ? [
                  ["30-day average", moneyShort(product.avg_price_30d)],
                  ["Listings, 30 days", count(product.listings_30d)],
                ]
              : [
                  ["30-day average", moneyShort(product.avg_price_30d)],
                  ["Listings, 30 days", count(product.listings_30d)],
                  ["Cheapest 25% under", moneyShort(product.cutoff_price_cheapest_25pct_30d)],
                ];
        return (
          <li>
            <a href={`/${category.category_key}/${product.slug}/${modelPath}`} class={`${link} block rounded-lg bg-white/10 px-3 py-2.5 hover:bg-white/20 hover:no-underline`}>
              <span class="block text-sm font-semibold leading-snug">{product.display_name}</span>
              <span class="mt-1.5 block space-y-0.5">
                {stats.map(([statLabel, statValue]) => (
                  <span class="flex items-baseline justify-between gap-3 text-xs">
                    <span class="text-white/70">{statLabel}</span>
                    <span class="font-semibold tabular-nums">{statValue}</span>
                  </span>
                ))}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
  <a href={href} class={`${link} mt-auto inline-block pt-4 text-sm font-semibold`}>
    {models.length > shownModels.length ? `All ${models.length} ${name} models →` : `All ${name} →`}
  </a>
</article>
